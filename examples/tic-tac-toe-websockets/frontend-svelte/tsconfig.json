{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // The linked packages carry their own node_modules; share one copy of
    // socket.io-client types (not needed when installed from npm)
    "paths": {
      "socket.io-client": ["./node_modules/socket.io-client"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
