{{#if (eq validation.type "zod")}}
import { z } from 'zod';

const UpdateAuthPermissionDto = z.object({
  resource: z.string().optional(),
  action: z.string().optional(),
  description: z.string().optional(),
  roles: z.array(z.object({
    id: z.string().min(1, 'Role ID is required'),
  })).optional(),
});

export default UpdateAuthPermissionDto;
{{#if typescript}}
export type UpdateAuthPermissionDto = z.infer<typeof UpdateAuthPermissionDto>;
{{/if}}
{{/if}}
{{#if (eq validation.type "class-validator")}}
import { IsString, IsOptional, IsArray, ValidateNested } from 'class-validator';
import { Transform, Type } from 'class-transformer';
import 'reflect-metadata';

class RoleConnectDto {
  @IsString()
  @IsNotEmpty({ message: 'Role ID is required' })
  id!: string;
}

export default class UpdateAuthPermissionDto {
  @IsOptional()
  @IsString()
  resource?: string;

  @IsOptional()
  @IsString()
  @Transform(({ value }) => String(value))
  action?: string;

  @IsOptional()
  @IsString()
  description?: string;

  @ValidateNested({ each: true })
  @IsArray()
  @Type(() => RoleConnectDto)
  @IsOptional()
  roles?: RoleConnectDto[];
}
{{/if}}
