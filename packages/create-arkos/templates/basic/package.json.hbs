{
  "name": "{{projectName}}",
  "version": "1.0.0",
  "type": "module",
  "description": "This RESTful API was generated by create-arkos, read more about Arkos.js at www.arkosjs.com",
  "scripts": {
    "dev": "arkos dev",
    "build": "arkos build",
    "start": "arkos start",
    "arkos": "arkos"
  },
  "prisma": {
    "schema": "prisma/schema/"
  },
  "devDependencies": {
    {{#if typescript}}
    "typescript": "5.8.2",
    "@types/node": "24.0.12",
    "@types/express": "4.17.25",
    {{/if}}
    "tsx-strict": "0.7.0",
    "tsx": "4.23.1"{{#if (neq prisma.provider "none")}},
    "prisma": "7.9.1"
    {{/if}}
  },
  "dependencies": {
    "arkos": "1.8.0-canary.10", 
    "express": "4.22.2",
    "@scalar/express-api-reference": "0.10.12",
    "@scalar/api-reference": "1.55.3"{{#if (or (neq prisma.provider "none") validation.type)}},{{/if}}
    {{#if (neq prisma.provider "none")}}
    "@prisma/client": "7.9.1",
    {{/if}}
    {{#if (eq prisma.provider "postgresql")}}
    "@prisma/adapter-pg": "7.9.1",
    {{/if}}
    {{#if (eq prisma.provider "cockroachdb")}}
    "@prisma/adapter-pg": "7.9.1",
    {{/if}}
    {{#if (eq prisma.provider "mysql")}}
    "@prisma/adapter-mariadb": "7.9.1",
    {{/if}}
    {{#if (eq prisma.provider "sqlite")}}
    "@prisma/adapter-better-sqlite3": "7.9.1",
    {{/if}}
    {{#if (eq prisma.provider "sqlserver")}}
    "@prisma/adapter-mssql": "7.9.1",
    {{/if}}
    {{#if (or (eq validation.type "class-validator") (eq validation.type "hybrid"))}}
    "reflect-metadata": "0.2.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1"{{#if (eq validation.type "hybrid")}},{{/if}}
    {{/if}}
    {{#if (or (eq validation.type "zod") (eq validation.type "hybrid"))}}
    "zod": "4.4.3"
    {{/if}}
  }
}
